# Assinatura via App Store Connect API (equivalente ao Codemagic Automatic).
# Runner do Actions é efêmero: a chave privada do cert morre no fim do job.
# Por isso revogamos Distribution órfãos antes de criar um novo (limite Apple = 2).

opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Distribution cert + App Store profile via ASC API"
  lane :sync_signing do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    keychain_name = ENV.fetch("MATCH_KEYCHAIN_NAME", "focux-signing")
    keychain_password = ENV.fetch("KEYCHAIN_PASSWORD")

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )

    revoke_orphan_distribution_certs!(api_key)

    cert(
      api_key: api_key,
      keychain_path: File.expand_path("~/Library/Keychains/#{keychain_name}-db"),
      keychain_password: keychain_password
    )

    sigh(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_BUNDLE_ID", "com.focux.focuxApp"),
      provisioning_name: "Focux Personal AppStore GHA",
      force: true
    )

    github_env = ENV["GITHUB_ENV"]
    if github_env && !github_env.empty?
      File.open(github_env, "a") do |f|
        f.puts "PROVISIONING_PROFILE_NAME=#{ENV.fetch('SIGH_NAME')}"
        f.puts "PROVISIONING_PROFILE_UUID=#{ENV.fetch('SIGH_UUID')}"
      end
    end

    UI.success("Signing ready: #{ENV['SIGH_NAME']} (#{ENV['SIGH_UUID']})")
  end
end

def revoke_orphan_distribution_certs!(api_key)
  # Token já vem do app_store_connect_api_key; reatribui para Spaceship.
  Spaceship::ConnectAPI.token = api_key

  types = %w[DISTRIBUTION IOS_DISTRIBUTION]
  certs = Spaceship::ConnectAPI::Certificate.all.select do |c|
    types.include?(c.certificate_type.to_s)
  end

  if certs.empty?
    UI.message("Nenhum Distribution cert na conta — ok.")
    return
  end

  UI.important("Revogando #{certs.length} Distribution cert(s) órfão(s) (CI sem chave privada persistida)...")
  certs.each do |certificate|
    UI.message("Revoke #{certificate.id} (#{certificate.certificate_type})")
    certificate.delete!
  end
end
