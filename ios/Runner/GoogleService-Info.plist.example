<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copie para GoogleService-Info.plist (gitignored) após criar o app iOS no Firebase.

  Checklist Google Sign-In (obrigatório para TestFlight — sem isso GIDSignIn aborta):
  1) Firebase/Google Cloud: OAuth client tipo iOS com Bundle ID com.focux.focuxApp
  2) CLIENT_ID e REVERSED_CLIENT_ID deste plist batem com esse client
  3) Info.plist tem GIDClientID = CLIENT_ID e URL scheme = REVERSED_CLIENT_ID
     (rode tools/ios/sync_google_signin_url_scheme.sh no build)
  4) Backend valida idToken com o Web client (GOOGLE_WEB_CLIENT_ID)

  Sem este arquivo o app sobe; FCM/Crashlytics ficam off no iOS. Sign-In ainda
  usa GIDClientID commitado no Info.plist.
-->
<plist version="1.0">
<dict>
	<key>CLIENT_ID</key>
	<string>YOUR_IOS_CLIENT_ID.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.YOUR_IOS_CLIENT_ID</string>
	<key>API_KEY</key>
	<string>YOUR_FIREBASE_API_KEY</string>
	<key>GCM_SENDER_ID</key>
	<string>YOUR_SENDER_ID</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>com.focux.focuxApp</string>
	<key>PROJECT_ID</key>
	<string>focux-personal</string>
	<key>STORAGE_BUCKET</key>
	<string>focux-personal.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:YOUR_SENDER_ID:ios:YOUR_APP_ID</string>
</dict>
</plist>
