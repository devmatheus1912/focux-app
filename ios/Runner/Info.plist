<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Focux Personal</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>focux_app</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- Portrait only - app is not designed for landscape -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
		</array>
		<!-- Sem Split View/Slide Over: permite portrait-only no iPad (App Store 90474) -->
		<key>UIRequiresFullScreen</key>
		<true/>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- Permissões de câmera/mídia para upload de GIF/vídeo de exercícios -->
		<key>NSCameraUsageDescription</key>
		<string>Usado para capturar fotos e vídeos de exercícios.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Usado para selecionar fotos e vídeos de exercícios.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Usado para salvar fotos de evolução e compartilhamentos no dispositivo.</string>
		<key>NSFaceIDUsageDescription</key>
		<string>Usado para confirmar assinaturas e proteger dados sensíveis com Face ID.</string>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>NSMicrophoneUsageDescription</key>
		<string>Usado para gravar áudios no chat, vídeos de exercícios com áudio e comandos de voz do Copiloto IA.</string>
		<!-- Reconhecimento de voz para o Copiloto IA -->
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>O Copiloto IA usa reconhecimento de voz para que você possa ditar comandos e registrar treinos sem digitar.</string>
		<!-- HealthKit -->
		<key>NSHealthShareUsageDescription</key>
		<string>Usado para ler dados de saude e acompanhar sua evolucao no Focux.</string>
		<key>NSHealthUpdateUsageDescription</key>
		<string>Usado para registrar dados de saude relacionados aos seus treinos no Focux.</string>
		<!-- FCM background notifications -->
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<!-- Google Sign-In (GIDSignIn). Sem GIDClientID + reversed URL scheme o SDK aborta (SIGABRT). -->
		<!-- CLIENT_ID alinhado ao OAuth iOS/Web do projeto 868715549357; se GoogleService-Info.plist
		     trouxer outro CLIENT_ID, rode ios/scripts/sync_google_signin_url_scheme.sh e atualize. -->
		<key>GIDClientID</key>
		<string>868715549357-kjut1ja3ab79j6pp3pquk2nha48atbcs.apps.googleusercontent.com</string>
		<!-- Deep link / URL scheme -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleURLName</key>
				<string>com.focux.focuxApp</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>focux</string>
				</array>
			</dict>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>GoogleSignIn</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<!-- REVERSED_CLIENT_ID do CLIENT_ID acima (obrigatório para GIDSignIn). -->
					<string>com.googleusercontent.apps.868715549357-kjut1ja3ab79j6pp3pquk2nha48atbcs</string>
				</array>
			</dict>
		</array>
		<!-- Flutter 3.16+: entrega Universal Links / App Links ao GoRouter. -->
		<key>FlutterDeepLinkingEnabled</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<true/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
	</dict>
</plist>
