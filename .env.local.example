# Copie para .env.local (gitignored). Preencha com valores do Firebase / backend.

GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# iOS release / patch Info.plist (OAuth client tipo iOS, bundle com.focux.focuxApp)
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
API_URL=https://your-backend.example.com
PUBLIC_WEB_URL=https://your-backend.example.com

# Nome do projeto na Vercel (opcional, para scripts de deploy)
VERCEL_PROJECT=your-vercel-project
