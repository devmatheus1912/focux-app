# Copy this to .env.local (already gitignored) and fill in real values.
# Used by scripts/run-android.ps1, run-web.ps1, build-android.ps1, build-web.ps1.

# Web OAuth Client ID from Google Cloud Console > Credentials > Focux Web.
# Format: <project-number>-<hash>.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=868715549357-XXXX.apps.googleusercontent.com

# Optional: override backend (default = Railway prod via Env.dart).
# API_URL=https://focux-backend-production.up.railway.app

# Optional: web port (default 61791).
# WEB_PORT=61791
