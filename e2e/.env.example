# Base URL where Flutter web app is served
E2E_BASE_URL=http://localhost:61791

# Personal trainer test account (must exist in backend)
E2E_PERSONAL_EMAIL=your-personal@example.com
E2E_PERSONAL_SENHA=SUA_SENHA_AQUI

# Student test account (must exist and be linked to the personal above)
E2E_ALUNO_EMAIL=your-aluno@example.com
E2E_ALUNO_SENHA=SUA_SENHA_AQUI

# Optional: id of an existing student to target in personal flows
E2E_ALUNO_ID=1
